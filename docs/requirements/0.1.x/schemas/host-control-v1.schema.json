{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivoraige:design:HostControl:1.0",
  "title": "HostControl@1 candidate 1.0 (design only)",
  "description": "Candidate producer/request shape checks. Request is generic HostControl; OwnerIPCRequest/OwnerIPCFrame are a distinct protected local transport. Runtime tests must prove authentication, locks, generation matching, deadlines and crash consistency. Response clients tolerate additive fields and unknown reasons. RecoveryRequest is local-only.",
  "$ref": "#/$defs/Request",

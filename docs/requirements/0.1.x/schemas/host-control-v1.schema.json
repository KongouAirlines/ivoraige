          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "drain"
        },
        "params": {
          "type": "object",
          "properties": {
            "budgetMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            }
          },
          "required": [
            "budgetMs"
          ],
          "additionalProperties": false
        },
        "expectedGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params",
        "expectedGeneration"
      ],
      "additionalProperties": false
    },
    "exitRequest": {
      "type": "object",
      "properties": {
        "interfaceVersion": {

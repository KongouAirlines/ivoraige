{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivoraige:design:HostControl:1.0",
  "title": "HostControl@1 candidate 1.0 (design only)",
  "description": "Producer/request shape checks only. Transport authentication, OS ownership, locks, generation comparison, deadlines and crash consistency require runtime tests. Response clients must tolerate additive fields and display unknown states as unknown. RecoveryRequest is local-only.",
  "$ref": "#/$defs/Request",
  "$defs": {
    "startRequest": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "start"
        },
        "params": {
          "type": "object",
          "properties": {
            "dataDomainRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "lifetime": {
              "enum": [
                "resident",
                "ephemeral"
              ]
            }
          },
          "required": [
            "dataDomainRef",
            "lifetime"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params"
      ],
      "additionalProperties": false
    },

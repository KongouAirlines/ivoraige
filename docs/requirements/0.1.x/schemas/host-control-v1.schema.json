          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "exit"
        },
        "params": {
          "type": "object",
          "properties": {
            "budgetMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            }
          },
          "required": [
            "budgetMs"
          ],
          "additionalProperties": false
        },
        "expectedGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params",
        "expectedGeneration"
      ],
      "additionalProperties": false
    },
    "operationRequest": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "operation"
        },
        "params": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,

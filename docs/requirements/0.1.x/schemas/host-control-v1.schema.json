            "dataDomainRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "requiredLifetime": {
              "enum": [
                "resident",
                "ephemeral"
              ]
            }
          },
          "required": [
            "dataDomainRef",
            "requiredLifetime"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params"
      ],
      "additionalProperties": false
    },
    "stateRequest": {
      "type": "object",
      "properties": {
        "interfaceVersion": {

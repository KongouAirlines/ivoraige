        },
        {
          "$ref": "#/$defs/forceExitRequest"
        }
      ]
    },
    "Blocker": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "operation",
            "worker",
            "storage",
            "registry",
            "control"
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "recovery": {
          "enum": [
            "wait",
            "retry",
            "repair",
            "explicit-force",
            "manual-recovery"
          ]
        }
      },
      "required": [
        "kind",
        "ref",
        "reason",
        "recovery"
      ],
      "additionalProperties": true
    },
    "State": {
      "type": "object",
      "properties": {
        "dataDomainRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "lifetime": {
          "enum": [
            "resident",
            "ephemeral"
          ]
        },
        "state": {
          "enum": [
            "starting",
            "ready",
            "draining",
            "stopping",
            "failed"
          ]
        },
        "acceptingBusiness": {
          "type": "boolean"
        },
        "stateRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "synchronization": {
          "enum": [
            "p04",
            "control-only"
          ]
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "maxItems": 100
        },
        "blockersTruncated": {
          "type": "boolean"
        },
        "storeOwnership": {
          "enum": [
            "held",
            "released",
            "unknown"
          ]
        }
      },
      "required": [
        "dataDomainRef",
        "generation",
        "lifetime",
        "state",
        "acceptingBusiness",
        "stateRevision",
        "synchronization",
        "operationId",
        "blockers",
        "blockersTruncated",
        "storeOwnership"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "acceptingBusiness": {
                "const": true
              },
              "storeOwnership": {
                "const": "held"
              }
            }
          },
          "else": {
            "properties": {
              "acceptingBusiness": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synchronization": {
                "const": "p04"
              }
            }
          },
          "then": {
            "properties": {
              "stateRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "else": {
            "properties": {
              "stateRevision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "starting",
                  "ready",
                  "draining"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "storeOwnership": {
                "enum": [
                  "held",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "operationId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "draining"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "operationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            }
          }
        }
      ]
    },
    "ControlOperation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "intent": {
          "enum": [
            "drain",
            "exit"
          ]
        },
        "phase": {
          "enum": [
            "gate",
            "admissions",
            "work",
            "resources",
            "quiescent",
            "storage",
            "release"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "blocked",
            "drained",
            "completed"
          ]
        },
        "remainingMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "safeToExit": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "maxItems": 100
        },
        "blockersTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "operationId",
        "generation",
        "intent",
        "phase",
        "status",
        "remainingMs",
        "reason",
        "safeToExit",
        "blockers",
        "blockersTruncated"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "drained"
              }
            }
          },
          "then": {
            "properties": {
              "intent": {
                "const": "drain"
              },
              "phase": {
                "const": "quiescent"
              },
              "safeToExit": {
                "const": true
              },
              "blockers": {
                "maxItems": 0
              },
              "blockersTruncated": {
                "const": false
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "safeToExit": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "drain"
              }
            },
            "required": [
              "intent"
            ]
          },
          "then": {
            "properties": {
              "phase": {
                "enum": [
                  "gate",
                  "admissions",
                  "work",
                  "resources",
                  "quiescent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "safeToExit": {
                "const": true
              }
            },
            "required": [
              "safeToExit"
            ]
          },
          "then": {
            "properties": {
              "phase": {
                "enum": [
                  "quiescent",
                  "storage",
                  "release"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "intent": {
                "const": "exit"
              },
              "phase": {
                "const": "release"
              },
              "safeToExit": {
                "const": true
              },
              "reason": {
                "type": "null"
              },
              "blockers": {
                "maxItems": 0
              },
              "blockersTruncated": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Only exit can complete after release and control cleanup. A live State lacks phase, so State/operation phase and physical process exit still require semantic checks."
    },
    "StateResponse": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "apiVersion": {
          "const": "2.0"
        },
        "state": {
          "$ref": "#/$defs/State"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "apiVersion",
        "state"
      ],
      "additionalProperties": true
    },
    "OperationResponse": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "apiVersion": {
          "const": "2.0"
        },
        "operation": {
          "$ref": "#/$defs/ControlOperation"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "apiVersion",
        "operation"
      ],
      "additionalProperties": true
    },
    "Accepted": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "apiVersion": {
          "const": "2.0"
        },
        "accepted": {
          "const": true
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "apiVersion",
        "accepted",
        "generation",
        "operationId"
      ],
      "additionalProperties": true
    },
    "Attached": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "apiVersion": {
          "const": "2.0"
        },
        "reused": {

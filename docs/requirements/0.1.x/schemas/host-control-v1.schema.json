        },
        "params": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "expectedGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params",
        "expectedGeneration"
      ],
      "additionalProperties": false
    },
    "drainRequest": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },

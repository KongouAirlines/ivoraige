          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "prepareForceExit"
        },
        "params": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "operationId"
          ],
          "additionalProperties": false
        },
        "expectedGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params",
        "expectedGeneration"
      ],
      "additionalProperties": false
    },
    "forceExitRequest": {
      "type": "object",
      "properties": {
        "interfaceVersion": {
          "const": "HostControl@1"
        },
        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "forceExit"
        },
        "params": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "challengeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "acknowledgeUnknownOutcome": {
              "const": true
            }
          },
          "required": [
            "operationId",
            "challengeId",
            "acknowledgeUnknownOutcome"
          ],
          "additionalProperties": false

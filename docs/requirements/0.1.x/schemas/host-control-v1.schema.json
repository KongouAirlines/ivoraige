        "minor": {
          "const": 0
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "action": {
          "const": "start"
        },
        "params": {
          "type": "object",
          "properties": {
            "dataDomainRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "lifetime": {
              "enum": [
                "resident",
                "ephemeral"
              ]
            }
          },
          "required": [
            "dataDomainRef",
            "lifetime"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "interfaceVersion",
        "minor",
        "requestId",
        "action",
        "params"
      ],
      "additionalProperties": false
    },

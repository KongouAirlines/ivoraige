{
  "name": "ivoraige",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "bin": {
    "ivoraige": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/app.mjs",
    "./src/app.mjs": "./src/app.mjs"
  },
  "files": [
    "src/",
    "dist/dsh.mjs",
    "dist/web/",
    "dist/DSH-LICENSE.txt",
    "dist/THIRD_PARTY_LICENSES.txt",
    "sidecars/babeldoc/server.py",
    "sidecars/babeldoc/requirements.lock",
    "sidecars/babeldoc/README.md",
    "scripts/setup-pdf.ps1",
    "examples/pdf-windows.json",
    "docs/plan/0.1.0/pdf-guide.md",
    "docs/plan/0.1.0/mcp-guide.md",
    "docs/plan/0.1.0/settings-guide.md",
    "docs/plan/0.1.0/installation-guide.md",
    "docs/plan/0.1.0/workbench-guide.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY.md",
    "README.zh-CN.md",
    "docs/assets/0.1.0/workbench.jpg",
    "docs/plan/0.1.0/capabilities.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/launch.mjs",
    "build:distribution": "npm run build && node scripts/build-distribution.mjs",
    "setup:dsh": "node scripts/setup-dsh.mjs",
    "build": "node scripts/build.mjs && node scripts/build-web.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:npm": "npm run build && node scripts/pack-npm.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "followups": "node scripts/followups.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@eslint-community/regexpp": "4.12.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@standard-schema/spec": "1.1.0",
    "ajv": "8.20.0",
    "chokidar": "4.0.3",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resolve.exports": "2.0.3",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "jsdom": "27.4.0",
    "marked": "18.1.1",
    "marked-gfm-heading-id": "4.1.4"
  }
}

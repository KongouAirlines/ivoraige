diff --git a/rust/p2_stages/src/stages/typesetting_tests.rs b/rust/p2_stages/src/stages/typesetting_tests.rs
new file mode 100644
index 0000000..61807ba
--- /dev/null
+++ b/rust/p2_stages/src/stages/typesetting_tests.rs
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+// Real native layout, font metrics, IR writes and obstacle checks. No PDF/model.
+use super::*;
+use babeldoc_font_core::{FontFamily, PrimaryFontFamily};
+use crate::{NoopCancellation, NoopProgress};
+
+const TEXT: &str = "An invented heading with ordinary alphabetic words";
+fn engine() -> Typesetting {
+    let path = std::env::var("IVORAIGE_TEST_FONT")
+        .expect("set IVORAIGE_TEST_FONT to NimbusSans-Regular.otf (URW Base35)");
+    let font = FontFace::load("ivoraige-test-font", path).unwrap();
+    let mapper = FontMapper::new(FontFamily {
+        normal: vec![font.clone()], base: vec![font], ..Default::default()
+    }, PrimaryFontFamily::SansSerif).unwrap();
+    Typesetting::new("en", Arc::new(mapper), true, HashMap::new())
+}
+fn b(x: f64, y: f64, x2: f64, y2: f64) -> Box {
+    Box { x: Some(x), y: Some(y), x2: Some(x2), y2: Some(y2) }
+}
+fn paragraph(box_: Box, text: &str) -> FieldValue<types::PdfParagraph> {
+    ir::PdfParagraphInit {
+        r#box: Some(box_field(box_)),
+        debug_id: Some("ivoraige-fit-fixture".into()),
+        unicode: Some(text.into()),
+        pdf_paragraph_composition: vec![ir::PdfParagraphCompositionInit {
+            pdf_same_style_unicode_characters: Some(ir::PdfSameStyleUnicodeCharactersInit {
+                unicode: Some(text.into()),
+                pdf_style: Some(ir::PdfStyleInit {
+                    font_id: Some("ivoraige-test-font".into()), font_size: Some(12.),
+                    ..Default::default()
+                }.into_value()), ..Default::default()
+            }.into_value()), ..Default::default()
+        }.into_value()], ..Default::default()
+    }.into_value()
+}
+fn document(width: f64, height: f64, bottom: f64, right: f64) -> ir::Document {
+    let mut d = ir::Document::from_parts(
+        ir::Node::new(ir::NodeData::Document(Default::default())),
+        Default::default(), Default::default()).unwrap();
+    let mut v = d.view::<TypesettingView>();
+    v.document().push_page(&mut v, ir::PageInit {
+        cropbox: Some(ir::CropboxInit {
+            // conflict() uses crop.y * 1.1 and crop.x2 * 0.9.
+            r#box: Some(box_field(b(0., bottom / 1.1, right / 0.9, 300.))),
+        }.into_value()),
+        pdf_paragraph: vec![paragraph(b(0., 0., width, height), TEXT)],
+        ..Default::default()
+    }.into_value()).unwrap();
+    drop(v);
+    d
+}
+#[derive(Default, Clone, Copy, Debug)]
+struct Change { bottom: bool, right: bool, geometry: bool, scale: bool, content: bool }
+fn trial(enabled: bool, width: f64, height: f64, bottom: f64, right: f64, change: Change)
+    -> (f64, f64, Box, usize)
+{
+    let engine = engine();
+    let mut d = document(width, height, bottom, right);
+    let mut v = d.view::<TypesettingView>();
+    let page = v.document().page_at(&v, 0).unwrap();
+    let p = page.pdf_paragraph_at(&v, 0).unwrap();
+    let original = read_box(p.r#box(&v).unwrap().unwrap(), &v).unwrap();
+    let mut plans = enabled.then(FitPlans::new);
+    engine.preprocess(&[page], &mut plans, &mut v,
+        &mut StageContext::new(&NoopCancellation, &NoopProgress)).unwrap();
+    let preflight = p.optimal_scale(&v).unwrap().unwrap();
+    assert!(same_box(&read_box(p.r#box(&v).unwrap().unwrap(), &v).unwrap(), &original));
+    if change.bottom {
+        page.push_pdf_figure(&mut v, ir::PdfFigureInit {
+            r#box: Some(box_field(b(0., -12., width, -5.))), ..Default::default()
+        }.into_value()).unwrap();
+    }
+    if change.right {
+        page.push_pdf_figure(&mut v, ir::PdfFigureInit {
+            r#box: Some(box_field(b(width+5., -10., width+20., height))), ..Default::default()
+        }.into_value()).unwrap();
+    }
+    if change.geometry { p.set_box(&mut v, Some(box_field(b(0., 1., width, height)))).unwrap(); }
+    if change.scale { p.set_optimal_scale(&mut v, Some(0.6)).unwrap(); }
+    if change.content {
+        let extra = paragraph(b(0.,0.,width,height), &TEXT.repeat(4));
+        page.push_pdf_paragraph(&mut v, extra).unwrap();
+        let q = page.pdf_paragraph_at(&v, 1).unwrap();
+        let mut composition = vec![];
+        for i in 0..q.pdf_paragraph_composition_len(&v).unwrap() {
+            let c = q.pdf_paragraph_composition_at(&v, i).unwrap();
+            composition.push(c.share(&mut v).unwrap());
+        }
+        p.set_pdf_paragraph_composition(&mut v, composition).unwrap();
+        // Remove the temporary fixture paragraph before obstacle checks.
+        let shared = p.share(&mut v).unwrap();
+        page.set_pdf_paragraph(&mut v, vec![shared]).unwrap();
+    }
+    let plan = plans.as_mut().and_then(|plans| plans.remove(&(0,0)));
+    if change.bottom || change.right || change.geometry || change.scale {
+        if let Some(plan) = &plan {
+            assert!(engine.permitted_fit_box(&p, &page, 0, plan,
+                p.optimal_scale(&v).unwrap().unwrap(), &v).unwrap().is_none());
+        }
+    }
+    let fonts = engine.font_map(&page, &v).unwrap();
+    engine.render_paragraph(&p, &page, 0, &fonts, plan, &mut v).unwrap();
+    assert!(plans.as_ref().is_none_or(|plans| plans.is_empty()));
+    let rendered = p.scale(&v).unwrap().unwrap();
+    let box_ = read_box(p.r#box(&v).unwrap().unwrap(), &v).unwrap();
+    let n = p.pdf_paragraph_composition_len(&v).unwrap();
+    assert!(n > 0);
+    for c in p.pdf_paragraph_composition_iter(&v).unwrap() {
+        let character = c.unwrap().pdf_character(&v).unwrap().unwrap();
+        let glyph = read_box(character.r#box(&v).unwrap().unwrap(), &v).unwrap();
+        let (x,y,x2,y2) = box_coordinates(&glyph).unwrap();
+        let (bx,by,bx2,by2) = box_coordinates(&box_).unwrap();
+        assert!(x >= bx-1e-8 && y >= by-1e-8 && x2 <= bx2+1e-8 && y2 <= by2+1e-8,
+            "glyph outside box: {:?}, {:?}", (x,y,x2,y2), (bx,by,bx2,by2));
+    }
+    (preflight, rendered, box_, n)
+}
+fn assert_same(a: (f64, f64, Box, usize), b: (f64, f64, Box, usize)) {
+    assert_eq!((a.0,a.1,a.3),(b.0,b.1,b.3));
+    assert!(same_box(&a.2,&b.2));
+}
+#[test]
+fn preflight_box_and_scale_survive_real_native_render() {
+    let baseline = trial(false,70.,24.,-22.,75.,Change::default());
+    let fixed = trial(true,70.,24.,-22.,75.,Change::default());
+    eprintln!("native preflight={} baseline={} fit-box-v1={}",baseline.0,baseline.1,fixed.1);
+    assert!((baseline.0-0.7).abs()<1e-9);
+    assert!((baseline.1-0.65).abs()<1e-9);
+    assert!((fixed.0-0.7).abs()<1e-9 && (fixed.1-0.7).abs()<1e-9);
+    assert_eq!(fixed.2.y,Some(-20.));
+    assert_eq!(baseline.3,fixed.3);
+}
+#[test]
+fn changed_original_global_scale_and_bottom_obstacle_use_upstream_fallback() {
+    for change in [Change {bottom:true,..Default::default()},
+                   Change {geometry:true,..Default::default()},
+                   Change {scale:true,..Default::default()}] {
+        let baseline=trial(false,70.,24.,-22.,75.,change);
+        let fixed=trial(true,70.,24.,-22.,75.,change);
+        assert_same(baseline,fixed);
+    }
+}
+#[test]
+fn horizontal_expansion_rechecks_current_obstacles() {
+    let fixed=trial(true,70.,24.,0.,160.,Change::default());
+    assert!(fixed.2.x2.unwrap()>70. && fixed.2.x2.unwrap()<=155.);
+    let change=Change{right:true,..Default::default()};
+    assert_same(trial(false,70.,24.,0.,160.,change),trial(true,70.,24.,0.,160.,change));
+}
+#[test]
+fn normal_fit_and_no_expansion_space_keep_native_results() {
+    for (width,height,bottom,right) in [(300.,40.,-22.,305.),(70.,24.,0.,75.)] {
+        assert_same(trial(false,width,height,bottom,right,Change::default()),
+                   trial(true,width,height,bottom,right,Change::default()));
+    }
+}
+#[test]
+fn reused_geometry_still_checks_all_current_units() {
+    let fixed=trial(true,70.,24.,-22.,75.,Change{content:true,..Default::default()});
+    assert!(fixed.1<fixed.0,"changed content must still undergo native fitting");
+}
+#[test]
+fn plans_are_consumed_per_paragraph_and_not_retained_between_documents() {
+    let engine=engine();
+    for enabled in [true,false,true] {
+        let mut d=document(70.,24.,-22.,75.);
+        engine.process_with_fit_box(&mut d,&mut StageContext::new(&NoopCancellation,&NoopProgress),enabled).unwrap();
+        let v=d.read();
+        let p=v.document().page_at(&v,0).unwrap().pdf_paragraph_at(&v,0).unwrap();
+        assert!((p.scale(&v).unwrap().unwrap()-if enabled{0.7}else{0.65}).abs()<1e-9);
+    }
+}
+#[test]
+fn malformed_or_non_expanding_plan_is_never_reused() {
+    let engine=engine(); let mut d=document(70.,24.,-22.,160.);
+    let v=d.view::<TypesettingView>(); let page=v.document().page_at(&v,0).unwrap();
+    let p=page.pdf_paragraph_at(&v,0).unwrap(); let original=b(0.,0.,70.,24.);
+    for fitted in [b(1.,-20.,70.,24.),b(0.,-20.,69.,24.),b(0.,-20.,70.,25.),
+                   b(0.,f64::NAN,70.,24.),b(0.,-20.,f64::INFINITY,24.),original.clone()] {
+        let plan=FitPlan{original:original.clone(),fitted,scale:0.7};
+        assert!(engine.permitted_fit_box(&p,&page,0,&plan,0.7,&v).unwrap().is_none());
+    }
+}
+#[test]
+fn public_process_uses_exact_environment_opt_in() {
+    let engine=engine(); let mut d=document(70.,24.,-22.,75.);
+    let expected=if std::env::var("IVORAIGE_FIT_BOX_V1").as_deref()==Ok("1"){0.7}else{0.65};
+    engine.process(&mut d,&mut StageContext::new(&NoopCancellation,&NoopProgress)).unwrap();
+    let v=d.read(); let p=v.document().page_at(&v,0).unwrap().pdf_paragraph_at(&v,0).unwrap();
+    assert!((p.scale(&v).unwrap().unwrap()-expected).abs()<1e-9);
+}
+#[test]
+fn current_right_obstacle_is_checked_in_expanded_vertical_region() {
+    let engine=engine(); let mut d=document(70.,24.,-22.,160.);
+    let mut v=d.view::<TypesettingView>(); let page=v.document().page_at(&v,0).unwrap();
+    let p=page.pdf_paragraph_at(&v,0).unwrap();
+    let plan=FitPlan{original:b(0.,0.,70.,24.),fitted:b(0.,-20.,155.,24.),scale:0.7};
+    assert!(engine.permitted_fit_box(&p,&page,0,&plan,0.7,&v).unwrap().is_some());
+    page.push_pdf_figure(&mut v,ir::PdfFigureInit{
+        r#box:Some(box_field(b(100.,-15.,120.,-5.))),..Default::default()
+    }.into_value()).unwrap();
+    assert!(engine.permitted_fit_box(&p,&page,0,&plan,0.7,&v).unwrap().is_none());
+}
+#[test]
+fn native_document_mode_change_rejects_the_preflight_plan() {
+    fn run(enabled:bool)->(f64,f64,Box,usize){
+        let engine=engine();let mut d=document(70.,24.,-22.,75.);
+        let mut v=d.view::<TypesettingView>();
+        v.document().push_page(&mut v,ir::PageInit{
+            cropbox:Some(ir::CropboxInit{r#box:Some(box_field(b(0.,-20.,75./0.9,300.)))}.into_value()),
+            pdf_paragraph:vec![paragraph(b(0.,0.,70.,24.),&TEXT.repeat(2))],..Default::default()
+        }.into_value()).unwrap();
+        let pages=v.document().page_iter(&v).unwrap().collect::<Result<Vec<_>,_>>().unwrap();
+        let p=pages[0].pdf_paragraph_at(&v,0).unwrap();
+        let mut plans=enabled.then(FitPlans::new);
+        engine.preprocess(&pages,&mut plans,&mut v,
+            &mut StageContext::new(&NoopCancellation,&NoopProgress)).unwrap();
+        let selected=p.optimal_scale(&v).unwrap().unwrap();
+        assert!(selected<0.7-1e-9,"second page must change the native weighted mode");
+        if let Some(plans)=&plans {
+            let plan=plans.get(&(0,0)).unwrap();
+            assert!((plan.scale-0.7).abs()<1e-9);
+            assert!(engine.permitted_fit_box(&p,&pages[0],0,plan,selected,&v).unwrap().is_none());
+            assert_eq!(plans.len(),2);
+        }
+        for (i,page) in pages.iter().enumerate(){engine.render_page(page,i,&mut plans,&mut v).unwrap();}
+        assert!(plans.is_none_or(|plans|plans.is_empty()));
+        (selected,p.scale(&v).unwrap().unwrap(),read_box(p.r#box(&v).unwrap().unwrap(),&v).unwrap(),
+            p.pdf_paragraph_composition_len(&v).unwrap())
+    }
+    assert_same(run(false),run(true));
+}
+#[test]
+fn unsuccessful_preflight_never_supplies_a_fit_box() {
+    let engine=engine();let mut d=document(0.1,1.,0.,0.1);
+    let mut v=d.view::<TypesettingView>();let page=v.document().page_at(&v,0).unwrap();
+    let p=page.pdf_paragraph_at(&v,0).unwrap();p.set_debug_id(&mut v,Some(String::new())).unwrap();
+    let fonts=engine.font_map(&page,&v).unwrap();
+    let mut units=engine.create_units(&p,&fonts,&mut v).unwrap();
+    let (scale,fitted)=engine.optimal(&p,&page,0,&mut units,1.,true,false,&mut v).unwrap();
+    assert_eq!(scale,1.);assert!(fitted.is_none());
+}

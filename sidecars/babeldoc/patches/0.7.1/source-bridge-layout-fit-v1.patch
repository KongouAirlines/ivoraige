+//! Standalone target for the derived typesetting regression. The release source
+//! omits upstream unit-test modules, so do not enable cfg(test) on the whole lib.
+pub use babeldoc_p2_stages::{StageContext, StageError, NoopCancellation, NoopProgress, shared};
+#[path = "../src/stages/typesetting.rs"]
+mod native_typesetting;

+fn finite_rect(b: Option<&B>) -> Option<(f64, f64, f64, f64)> {
+    let b = b?;
+    let (x, y, x2, y2) = (b.x?, b.y?, b.x2?, b.y2?);
+    (x.is_finite() && y.is_finite() && x2.is_finite() && y2.is_finite() && x2 > x && y2 > y)
+        .then_some((x, y, x2, y2))
+}
+
+fn ascii_alnum(text: Option<&str>) -> bool {
+    text.is_some_and(|text| text.len() == 1 && text.as_bytes()[0].is_ascii_alphanumeric())
+}
+
+// Only a low underscore between adjacent, same-baseline ASCII word glyphs borrows
+// their ink bounds for line classification. The source glyph and geometry stay intact.
+fn ascii_alnum_base_v1_bounds(
+    left: &PdfCharacter,
+    underscore: &PdfCharacter,
+    right: &PdfCharacter,
+) -> Option<(f64, f64)> {
+    if underscore.char_unicode.as_deref() != Some("_")
+        || !ascii_alnum(left.char_unicode.as_deref())
+        || !ascii_alnum(right.char_unicode.as_deref())
+        || [left, underscore, right].iter().any(|c| c.vertical != Some(false))
+    {
+        return None;
+    }
+    let xobj = left.xobj_id?;
+    if underscore.xobj_id != Some(xobj) || right.xobj_id != Some(xobj) {
+        return None;
+    }
+    let styles = [left, underscore, right].map(|c| c.pdf_style.as_deref());
+    let [Some(ls), Some(us), Some(rs)] = styles else { return None; };
+    let font = ls.font_id.as_ref()?;
+    let em = ls.font_size?;
+    if !em.is_finite() || em <= 0. || us.font_id.as_ref() != Some(font)
+        || rs.font_id.as_ref() != Some(font)
+        || us.font_size != Some(em) || rs.font_size != Some(em)
+    {
+        return None;
+    }
+    let [l, u, r] = [left, underscore, right].map(|c| {
+        finite_rect(c.visual_bbox.as_deref()?.r#box.as_deref())
+    });
+    let (Some(l), Some(u), Some(r)) = (l, u, r) else { return None; };
+    if !(l.0 < u.0 && u.0 < r.0) {
+        return None;
+    }
+    for gap in [u.0 - l.2, r.0 - u.2] {
+        if gap < -0.15 * em || gap > 0.5 * em {
+            return None;
+        }
+    }
+    let lc = (l.1 + l.3) / 2.;
+    let uc = (u.1 + u.3) / 2.;
+    let rc = (r.1 + r.3) / 2.;
+    if uc > lc.min(rc) - 0.2 * em || lc.max(rc) - uc > em
+        || l.3.min(r.3) <= l.1.max(r.1)
+    {
+        return None;
+    }
+    let [ln, un, rn] = [left, underscore, right]
+        .map(|c| finite_rect(c.r#box.as_deref()));
+    let (Some(ln), Some(un), Some(rn)) = (ln, un, rn) else { return None; };
+    let low = ln.1.min(un.1).min(rn.1);
+    let high = ln.1.max(un.1).max(rn.1);
+    let top_low = ln.3.min(un.3).min(rn.3);
+    let top_high = ln.3.max(un.3).max(rn.3);
+    (high - low <= 0.05 * em && top_high - top_low <= 0.05 * em)
+        .then_some((l.1.min(r.1), l.3.max(r.3)))
+}

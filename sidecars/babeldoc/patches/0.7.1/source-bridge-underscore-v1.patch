+#[cfg(test)]
+mod ivoraige_underscore_tests {
+    use super::*;
+    use babeldoc_il_types::{PdfStyle, VisualBbox};
+
+    fn glyph(symbol: &str, x: f64, nominal_y: f64, ink_y: f64, ink_h: f64) -> PdfCharacter {
+        let b = |y, h| B { x: Some(x), y: Some(y), x2: Some(x + 4.), y2: Some(y + h) };
+        PdfCharacter {
+            char_unicode: Some(symbol.into()),
+            r#box: Some(Box::new(b(nominal_y, 12.))),
+            visual_bbox: Some(Box::new(VisualBbox { r#box: Some(Box::new(b(ink_y, ink_h))) })),
+            pdf_style: Some(Box::new(PdfStyle { font_id: Some("F".into()), font_size: Some(12.), ..Default::default() })),
+            vertical: Some(false),
+            xobj_id: Some(1),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn joins_only_a_low_same_baseline_ascii_identifier() {
+        let left = glyph("X", 0., 8., 8., 3.);
+        let low = glyph("_", 5., 8., 0., 1.);
+        let right = glyph("Y", 10., 8., 8., 6.);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &low, &right), Some((8., 14.)));
+        let hyphen = glyph("-", 5., 8., 0., 1.);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &hyphen, &right), None);
+    }
+
+    #[test]
+    fn leaves_formula_neighbours_offsets_and_unrelated_glyphs_alone() {
+        let left = glyph("X", 0., 8., 8., 3.);
+        let low = glyph("_", 5., 8., 0., 1.);
+        let right = glyph("Y", 10., 8., 8., 6.);
+        assert!(ascii_alnum_base_v1_bounds(&left, &low, &glyph("2", 10., 8., 8., 6.)).is_some());
+        for other in [glyph("+", 10., 8., 8., 6.),
+            glyph("א", 10., 8., 8., 6.)] {
+            assert_eq!(ascii_alnum_base_v1_bounds(&left, &low, &other), None);
+        }
+        for other in [glyph("_", 5., 6., 0., 1.), glyph("_", 5., 8., -20., 1.),
+            glyph("_", 20., 8., 0., 1.)] {
+            assert_eq!(ascii_alnum_base_v1_bounds(&left, &other, &right), None);
+        }
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &low, &glyph("2", 10., 3., 3., 6.)), None);
+        let mut subscript = glyph("2", 10., 3., 3., 6.);
+        subscript.pdf_style.as_mut().unwrap().font_size = Some(10.);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &low, &subscript), None);
+        let mut other = low.clone();
+        other.xobj_id = Some(2);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &other, &right), None);
+        other = low.clone();
+        other.vertical = Some(true);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &other, &right), None);
+        other = low.clone();
+        other.pdf_style.as_mut().unwrap().font_size = Some(8.);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &other, &right), None);
+        other = low.clone();
+        other.pdf_style.as_mut().unwrap().font_id = Some("G".into());
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &other, &right), None);
+        other = low.clone();
+        other.r#box.as_mut().unwrap().y = Some(f64::NAN);
+        assert_eq!(ascii_alnum_base_v1_bounds(&left, &other, &right), None);
+    }
+}

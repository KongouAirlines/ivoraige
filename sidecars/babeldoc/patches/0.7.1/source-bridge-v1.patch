@@ -769,6 +769,38 @@ impl MDocument {
         if capture_stages {
             capture_at(&self.document, &capture_paths, "styles")?;
         }
+        // ivoraige bridge v1: read-only inventory before any translation changes.
+        // Opt-in only; ordinary upstream translators retain their behavior.
+        let source_translator = executors
+            .get_item("translation")?
+            .ok_or_else(|| PyValueError::new_err("missing translation callback executor"))?
+            .getattr("service")?
+            .getattr("translator")?;
+        if source_translator.hasattr("ivoraige_source_inventory")? {
+            let view = self.document.view::<ir::ReadOnlyView>();
+            let mut inventory = Vec::new();
+            for (page_index, page) in view.document().page_iter(&view).map_err(access_error)?.enumerate() {
+                let page = page.map_err(access_error)?;
+                for (paragraph_index, paragraph) in page.pdf_paragraph_iter(&view).map_err(access_error)?.enumerate() {
+                    let paragraph = paragraph.map_err(access_error)?;
+                    let bbox = paragraph.r#box(&view).map_err(access_error)?.map(|b| {
+                        Ok::<_, PyErr>([
+                            b.x(&view).map_err(access_error)?, b.y(&view).map_err(access_error)?,
+                            b.x2(&view).map_err(access_error)?, b.y2(&view).map_err(access_error)?,
+                        ])
+                    }).transpose()?;
+                    inventory.push(serde_json::json!({
+                        "pageIndex": page_index, "paragraphIndex": paragraph_index,
+                        "page": page.page_number(&view).map_err(access_error)?,
+                        "bbox": bbox,
+                        "sourceUnicode": paragraph.unicode(&view).map_err(access_error)?,
+                        "layoutLabel": paragraph.layout_label(&view).map_err(access_error)?,
+                    }));
+                }
+            }
+            let payload = serde_json::to_string(&inventory).map_err(|error| PyRuntimeError::new_err(error.to_string()))?;
+            source_translator.call_method1("ivoraige_source_inventory", (payload,))?;
+        }
         // The 0.6.4 probe happens after styles and before term extraction. Keep
         // it as a Python callback so caller supplied translator objects retain
         // their own behavior and the original exception/logging policy.

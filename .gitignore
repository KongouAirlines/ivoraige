# Local evaluation originals, reference translations and generated run artifacts.
/evaluation/private/
/evaluation/runs/

# Staged source documents: keep accidental root-level copies out of Git too.
/*.pdf
/*.epub
/*.mobi
/*.azw
/*.azw3
/*.djvu

# M1 upstream checkouts and local experiment dependencies.
/experiments/vendor/
/experiments/**/node_modules/
/experiments/**/.venv/
/experiments/**/__pycache__/
/experiments/**/.npm-cache/

# Generated artifacts left by the retired Cordis/DSH experiment.
/experiments/cordis-dsh/bridge.bundle.mjs
/experiments/cordis-dsh/build-evidence.json
/experiments/cordis-dsh/results.json

# M2 pinned upstream source, dependencies, generated bundle and local records.
/vendor/
/node_modules/
/dist/
/.ivoraige/

# Local credentials; only intentionally public templates may be committed.
.env
.env.*
!.env.example
.credentials.yaml
